<Window x:Class="Efesto.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Efesto — Compilador de aplicações">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="32,24" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Width="52" Height="52" Source="Assets/efesto.svg" AutomationProperties.Name="Efesto: monograma E com uma chama"/>
    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Efesto" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Do código à publicação." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4"><TextBlock Text="COMPILADOR DE APLICAÇÕES" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="SaveStatus" Text="Configuração automática" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="32,24" Spacing="22">
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
    <ContentControl x:Name="EnvironmentPanel" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
     <TextBlock Text="Ambiente de compilação" FontSize="18" FontWeight="SemiBold"/>
     <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel Spacing="16">
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="DevCmdBox" Header="Developer Command Prompt" PlaceholderText="C:\...\Common7\Tools\VsDevCmd.bat" TextChanged="ConfigurationChanged"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
         <Button x:Name="DetectButton" Content="Detectar novamente" Click="DetectDevCmd"/>
         <Button Content="Procurar" Click="BrowseDevCmd" AutomationProperties.Name="Selecionar Developer Command Prompt"/>
        </StackPanel>
       </Grid>
       <TextBlock x:Name="DevCmdStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="DestinationBox" Header="Pasta de saída" PlaceholderText="Selecione onde salvar as aplicações compiladas" TextChanged="ConfigurationChanged"/>
        <Button Grid.Column="1" Content="Procurar" VerticalAlignment="Bottom" Click="BrowseDestination" AutomationProperties.Name="Selecionar pasta de saída"/>
       </Grid>
       <CheckBox x:Name="ZipCheck" Content="Gerar ZIP com todas as aplicações selecionadas" Checked="ConfigurationChanged" Unchecked="ConfigurationChanged"/>
      </StackPanel>
     </Border>
    </StackPanel></ContentControl>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="4"><TextBlock Text="Compilações" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <Button x:Name="AddButton" Grid.Column="1" Click="AddJob" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="Adicionar compilação"/></StackPanel></Button>
    </Grid>
    <StackPanel x:Name="JobsPanel" Spacing="14"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Padding="32,18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Spacing="6"><TextBlock x:Name="RunStatus" Text="Tudo pronto para configurar sua compilação." TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="RunProgress" Visibility="Collapsed" Height="3" Maximum="100"/></StackPanel>
    <Button x:Name="OpenButton" Grid.Column="1" Content="Abrir saída" Click="OpenDestination"/>
    <Button x:Name="ExportButton" Grid.Column="2" Content="Gerar BAT" Click="ExportBatch"/>
    <Button x:Name="RunButton" Grid.Column="3" Content="Compilar" Style="{StaticResource AccentButtonStyle}" MinWidth="140" Click="RunClicked"/>
   </Grid>
  </Border>
 </Grid>
</Window>
