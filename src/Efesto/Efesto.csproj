<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Efesto</RootNamespace>
    <AssemblyName>Efesto</AssemblyName>
    <Product>Efesto</Product>
    <Title>Efesto — Compilador de aplicações</Title>
    <Description>Do código à publicação.</Description>
    <ApplicationIcon>Assets\efesto.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\efesto.svg;Assets\efesto.ico;Assets\efesto.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="../Efesto.Core/Efesto.Core.csproj" />
  </ItemGroup>
  <!-- Unpackaged dotnet publish must carry the compiled XAML and this app's resource index. -->
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_WinUIResource Include="$(TargetDir)**\*.xbf;$(TargetDir)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_WinUIResource)">
        <RelativePath>%(_WinUIResource.RecursiveDir)%(_WinUIResource.Filename)%(_WinUIResource.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
